<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>امتحان تحديد مستوى اللغة الإنجليزية مع لوحة الآدمن و Supabase</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f3ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    },
                    fontFamily: {
                        sans: ['Tajawal', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js for statistics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(99,102,241,0.3); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(99,102,241,0.6); }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-full flex flex-col transition-colors duration-200">

    <!-- Navbar Header -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            
            <!-- Logo & Title -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="resetToHome()">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900 dark:text-white leading-tight">اختبار تحديد المستوى</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">English CEFR Assessment Test</p>
                </div>
            </div>

            <!-- Header Controls & Actions -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Admin Dashboard Button -->
                <button onclick="openAdminModal()" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition flex items-center gap-2 shadow-md shadow-indigo-500/20 active:scale-95">
                    <i class="fa-solid fa-user-shield text-sm text-indigo-200"></i>
                    <span class="hidden sm:inline">لوحة الآدمن</span>
                </button>

                <!-- Supabase Connection Config Status -->
                <button onclick="openSupabaseConfigModal()" id="supabaseStatusBadge" class="px-3 py-1.5 rounded-xl bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 text-xs font-medium transition flex items-center gap-1.5 hover:opacity-90">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    <span id="supabaseStatusText" class="hidden md:inline">إعدادات Supabase</span>
                    <i class="fa-solid fa-database text-xs"></i>
                </button>

                <!-- SQL Schema Button -->
                <button onclick="openSqlModal()" class="px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 text-xs font-medium transition flex items-center gap-1.5 hover:opacity-90">
                    <i class="fa-solid fa-code text-xs"></i>
                    <span class="hidden md:inline">أوامر SQL Supabase</span>
                </button>

                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-600 transition">
                    <i class="fa-solid fa-moon dark:hidden"></i>
                    <i class="fa-solid fa-sun hidden dark:block text-amber-400"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col justify-center">

        <!-- VIEW 1: Welcome / Registration View -->
        <section id="welcomeView" class="block">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100 dark:border-slate-700 text-center max-w-2xl mx-auto">
                <div class="w-16 h-16 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mx-auto mb-6 text-2xl shadow-inner">
                    <i class="fa-solid fa-award"></i>
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-3">مرحباً بك في اختبار تحديد المستوى باللغة الإنجليزية</h2>
                <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
                    تم تصميم هذا الاختبار لتقييم مهاراتك من المستوى المبتدئ <span class="font-bold text-indigo-600 dark:text-indigo-400">(A1)</span> حتى المستوى المتقدم <span class="font-bold text-indigo-600 dark:text-indigo-400">(C1)</span> طبقاً للإطار الأوروبي المرجعي العام للغات (CEFR).
                </p>

                <!-- Exam Metrics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8 text-right">
                    <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1"><i class="fa-regular fa-clock ml-1"></i>المدة</div>
                        <div class="font-bold text-sm text-slate-800 dark:text-slate-200">20 دقيقة</div>
                    </div>
                    <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1"><i class="fa-solid fa-list-check ml-1"></i>الأسئلة</div>
                        <div class="font-bold text-sm text-slate-800 dark:text-slate-200">25 سؤالاً</div>
                    </div>
                    <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1"><i class="fa-solid fa-font ml-1"></i>المهارات</div>
                        <div class="font-bold text-sm text-slate-800 dark:text-slate-200">شامل المهارات</div>
                    </div>
                    <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1"><i class="fa-solid fa-cloud-arrow-up ml-1"></i>الحفظ</div>
                        <div class="font-bold text-sm text-slate-800 dark:text-slate-200">تلقائي لـ Supabase</div>
                    </div>
                </div>

                <!-- Student Registration Form -->
                <form id="startForm" onsubmit="startTest(event)" class="space-y-4 text-right">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">الاسم الكامل *</label>
                        <div class="relative">
                            <input type="text" id="studentName" required placeholder="أدخل اسمك الكريم" class="w-full px-4 py-3 pl-10 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none text-sm transition">
                            <i class="fa-regular fa-user absolute left-3 top-3.5 text-slate-400"></i>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">البريد الإلكتروني (اختياري لربطه بالنتيجة)</label>
                        <div class="relative">
                            <input type="email" id="studentEmail" placeholder="example@domain.com" class="w-full px-4 py-3 pl-10 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none text-sm transition">
                            <i class="fa-regular fa-envelope absolute left-3 top-3.5 text-slate-400"></i>
                        </div>
                    </div>
                    <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2">
                        <span>ابدأ الاختبار الآن</span>
                        <i class="fa-solid fa-arrow-left"></i>
                    </button>
                </form>
            </div>
        </section>

        <!-- VIEW 2: Interactive Exam Screen -->
        <section id="examView" class="hidden">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-700">
                
                <!-- Exam Header Bar -->
                <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-700 mb-6 gap-2">
                    <div>
                        <span id="categoryBadge" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-300 mb-1">
                            Grammar
                        </span>
                        <h3 class="text-xs text-slate-500 dark:text-slate-400">السؤال <span id="currentQNum">1</span> من <span id="totalQNum">25</span></h3>
                    </div>

                    <!-- Timer Badge -->
                    <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-700 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-200 font-mono font-bold text-sm">
                        <i class="fa-regular fa-clock text-indigo-500"></i>
                        <span id="timerText">20:00</span>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden mb-8">
                    <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-full w-0 transition-all duration-300"></div>
                </div>

                <!-- Listening Audio Player Prompt (for audio questions) -->
                <div id="audioSection" class="hidden mb-6 p-4 bg-indigo-50 dark:bg-indigo-950/40 rounded-2xl border border-indigo-100 dark:border-indigo-900/50 text-center">
                    <p class="text-xs text-indigo-900 dark:text-indigo-200 font-bold mb-2">استمع للنص الصوتي قبل الإجابة:</p>
                    <button id="playAudioBtn" onclick="playAudioPrompt()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-2 mx-auto shadow-md">
                        <i class="fa-solid fa-volume-high"></i>
                        <span id="audioBtnText">تشغيل الصوت</span>
                    </button>
                </div>

                <!-- Reading Comprehension Text (for reading questions) -->
                <div id="readingSection" class="hidden mb-6 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-200 dark:border-slate-600 text-sm leading-relaxed text-slate-800 dark:text-slate-200 font-serif" dir="ltr">
                    <!-- Text inserted dynamically -->
                </div>

                <!-- Question Text -->
                <div class="mb-6">
                    <h2 id="questionText" class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug" dir="ltr">
                        Loading Question...
                    </h2>
                </div>

                <!-- Options Grid -->
                <div id="optionsContainer" class="space-y-3 mb-8" dir="ltr">
                    <!-- Options inserted dynamically -->
                </div>

                <!-- Exam Navigation Buttons -->
                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button onclick="prevQuestion()" id="prevBtn" class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-xs sm:text-sm transition disabled:opacity-40 disabled:cursor-not-allowed">
                        السابق
                    </button>

                    <button onclick="nextQuestion()" id="nextBtn" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm transition shadow-md shadow-indigo-500/20">
                        التالي
                    </button>
                </div>
            </div>
        </section>

        <!-- VIEW 3: Results & CEFR Certificate Screen -->
        <section id="resultsView" class="hidden">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-100 dark:border-slate-700 text-center">
                
                <div class="inline-block p-4 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 mb-4">
                    <i class="fa-solid fa-circle-check text-3xl"></i>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-1">تمت الإجابة بنجاح!</h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6">تقرير النتيجة الرسمية لاختبار تحديد المستوى CEFR</p>

                <!-- Main Level Badge Card -->
                <div class="bg-gradient-to-br from-indigo-600 to-indigo-800 text-white p-6 sm:p-8 rounded-3xl shadow-xl mb-8 relative overflow-hidden">
                    <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
                    <div class="text-xs uppercase tracking-widest font-bold text-indigo-200 mb-2">مستواك المعتمد في اللغة الإنجليزية</div>
                    <div id="resultCefrBadge" class="text-4xl sm:text-6xl font-black mb-2 tracking-tight">
                        B2 - Upper Intermediate
                    </div>
                    <p id="resultCefrDesc" class="text-indigo-100 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
                        تستطيع فهم الأفكار الرئيسية للنصوص المعقدة والتفاعل بعفوية مع المتحدثين الأصليين.
                    </p>
                    <div class="mt-6 inline-flex items-center gap-4 bg-white/10 backdrop-blur-md px-6 py-2.5 rounded-2xl text-xs sm:text-sm font-bold border border-white/20">
                        <span>الدرجة الكلية: <strong id="resultScoreText">18/25</strong></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-300"></span>
                        <span>النسبة المئوية: <strong id="resultPercentText">72%</strong></span>
                    </div>
                </div>

                <!-- Skills Breakdown Chart and Details -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 text-right">
                    <!-- Chart -->
                    <div class="bg-slate-50 dark:bg-slate-700/50 p-4 sm:p-6 rounded-2xl border border-slate-100 dark:border-slate-700 flex flex-col items-center justify-center">
                        <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-4 w-full text-right">تحليل المهارات بالأداء:</h4>
                        <div class="w-full max-w-[260px] h-[220px]">
                            <canvas id="skillsChart"></canvas>
                        </div>
                    </div>

                    <!-- Recommendation Card -->
                    <div class="bg-slate-50 dark:bg-slate-700/50 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 flex flex-col justify-between">
                        <div>
                            <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-3"><i class="fa-solid fa-lightbulb text-amber-500 ml-1"></i>التوصيات الأكاديمية لمستواك:</h4>
                            <p id="recommendationText" class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                                يُنصح بالتركيز على تحسين مفردات المصطلحات التخصصية وممارسة المحادثة مع متحدثين أصليين لتطوير مهارة الطلاقة.
                            </p>
                        </div>
                        <div id="saveStatusNote" class="text-xs p-3 rounded-xl bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 flex items-center gap-2 border border-emerald-200 dark:border-emerald-800">
                            <i class="fa-solid fa-cloud-check text-emerald-500"></i>
                            <span>تم حفظ نتيجتك بنجاح في قاعدة البيانات (Supabase).</span>
                        </div>
                    </div>
                </div>

                <!-- Result Action Buttons -->
                <div class="flex flex-wrap items-center justify-center gap-3">
                    <button onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs sm:text-sm transition flex items-center gap-2 shadow-md">
                        <i class="fa-solid fa-print"></i>
                        <span>طباعة التقرير / PDF</span>
                    </button>
                    <button onclick="resetToHome()" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm transition flex items-center gap-2 shadow-md">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>إعادة الاختبار</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- VIEW 4: Admin Dashboard Screen -->
        <section id="adminView" class="hidden">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100 dark:border-slate-700">
                
                <!-- Admin Header Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-700 mb-6">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="p-2 rounded-xl bg-indigo-100 text-indigo-600 dark:bg-indigo-900/50 dark:text-indigo-400">
                                <i class="fa-solid fa-user-shield text-lg"></i>
                            </span>
                            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">لوحة تحكم المسؤول (Admin Dashboard)</h2>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">عرض جميع نتائج الطلاب واختبارات تحديد المستوى المسجلة</p>
                    </div>

                    <div class="flex items-center gap-2">
                        <button onclick="fetchAdminData()" class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 text-xs font-bold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-arrows-rotate"></i>
                            <span>تحديث</span>
                        </button>
                        <button onclick="exportToCSV()" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-file-excel"></i>
                            <span>تصدير Excel</span>
                        </button>
                        <button onclick="closeAdminDashboard()" class="px-3.5 py-2 rounded-xl bg-rose-100 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300 hover:bg-rose-200 text-xs font-bold transition">
                            خروج
                        </button>
                    </div>
                </div>

                <!-- Admin Analytics Cards Summary -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">إجمالي المتقدمين</div>
                        <div id="adminStatTotal" class="text-2xl font-black text-indigo-600 dark:text-indigo-400">0</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">متوسط النسبة</div>
                        <div id="adminStatAvg" class="text-2xl font-black text-emerald-600 dark:text-emerald-400">0%</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">أعلى مستوى شائع</div>
                        <div id="adminStatTopLevel" class="text-2xl font-black text-amber-500">-</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-100 dark:border-slate-700">
                        <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">مصدر البيانات الحالي</div>
                        <div id="adminStatSource" class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-2">Supabase DB</div>
                    </div>
                </div>

                <!-- Search and Filter Bar -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-6">
                    <div class="relative w-full sm:w-72">
                        <input type="text" id="adminSearchInput" oninput="filterAdminResults()" placeholder="البحث باسم الطالب أو البريد..." class="w-full px-3.5 py-2 pl-9 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-xs text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 outline-none">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    </div>

                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <select id="adminLevelFilter" onchange="filterAdminResults()" class="px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-600 dark:bg-slate-700 text-xs text-slate-900 dark:text-white outline-none">
                            <option value="ALL">جميع المستويات</option>
                            <option value="A1">A1 - Beginner</option>
                            <option value="A2">A2 - Elementary</option>
                            <option value="B1">B1 - Intermediate</option>
                            <option value="B2">B2 - Upper Intermediate</option>
                            <option value="C1">C1 - Advanced</option>
                        </select>
                    </div>
                </div>

                <!-- Submissions Table -->
                <div class="overflow-x-auto custom-scrollbar rounded-2xl border border-slate-200 dark:border-slate-700">
                    <table class="w-full text-right text-xs text-slate-700 dark:text-slate-300">
