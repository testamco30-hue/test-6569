    time_spent_seconds INTEGER DEFAULT 0,
    category_breakdown JSONB
);

-- 2. Enable Row Level Security (RLS)
ALTER TABLE public.test_results ENABLE ROW LEVEL SECURITY;

-- 3. Drop existing policies if any
DROP POLICY IF EXISTS "Allow public insert to test_results" ON public.test_results;
DROP POLICY IF EXISTS "Allow public read access to test_results" ON public.test_results;
DROP POLICY IF EXISTS "Allow public delete from test_results" ON public.test_results;
DROP POLICY IF EXISTS "Allow public update to test_results" ON public.test_results;

-- 4. Create Security Policies for Full Access
CREATE POLICY "Allow public insert to test_results"
    ON public.test_results
    FOR INSERT 
    WITH CHECK (true);

CREATE POLICY "Allow public read access to test_results"
    ON public.test_results
    FOR SELECT 
    USING (true);

CREATE POLICY "Allow public delete from test_results"
    ON public.test_results
    FOR DELETE 
    USING (true);

CREATE POLICY "Allow public update to test_results"
    ON public.test_results
    FOR UPDATE 
    USING (true)
    WITH CHECK (true);

-- 5. Create performance indexes
CREATE INDEX IF NOT EXISTS idx_test_results_created ON public.test_results (created_at DESC);
CREATE INDEX IF NOT EXISTS idx_test_results_cefr ON public.test_results (cefr_level);
CREATE INDEX IF NOT EXISTS idx_test_results_email ON public.test_results (student_email);</code></pre>
