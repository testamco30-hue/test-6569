        window.onload = function() {
            // Check saved theme
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }

            // Check saved Supabase config
            const savedUrl = localStorage.getItem('supabase_url');
            const savedKey = localStorage.getItem('supabase_key');
            if (savedUrl && savedKey) {
                initSupabase(savedUrl, savedKey);
            }
        };

        function toggleDarkMode() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        function initSupabase(url, key) {
            try {
                supabaseClient = supabase.createClient(url, key);
                isSupabaseConfigured = true;
                document.getElementById('supabaseStatusBadge').className = "px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 text-xs font-medium transition flex items-center gap-1.5 hover:opacity-90";
                document.getElementById('supabaseStatusText').innerText = "Supabase متصل";
            } catch (err) {
                console.error("Supabase init error:", err);
                isSupabaseConfigured = false;
            }
        }

        function openSupabaseConfigModal() {
            document.getElementById('cfgSupaUrl').value = localStorage.getItem('supabase_url') || '';
            document.getElementById('cfgSupaKey').value = localStorage.getItem('supabase_key') || '';
            document.getElementById('supabaseConfigModal').classList.remove('hidden');
        }

        function closeSupabaseConfigModal() {
            document.getElementById('supabaseConfigModal').classList.add('hidden');
        }

        function saveSupabaseConfig(e) {
            e.preventDefault();
            const url = document.getElementById('cfgSupaUrl').value.trim();
            const key = document.getElementById('cfgSupaKey').value.trim();
            if (url && key) {
                localStorage.setItem('supabase_url', url);
                localStorage.setItem('supabase_key', key);
                initSupabase(url, key);
                closeSupabaseConfigModal();
            }
        }

        function useLocalStorageOnly() {
            localStorage.removeItem('supabase_url');
            localStorage.removeItem('supabase_key');
            isSupabaseConfigured = false;
            supabaseClient = null;
            document.getElementById('supabaseStatusBadge').className = "px-3 py-1.5 rounded-xl bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 text-xs font-medium transition flex items-center gap-1.5 hover:opacity-90";
            document.getElementById('supabaseStatusText').innerText = "وضع محلي (Local)";
            closeSupabaseConfigModal();
        }

        function openSqlModal() { document.getElementById('sqlModal').classList.remove('hidden'); }
        function closeSqlModal() { document.getElementById('sqlModal').classList.add('hidden'); }

        function copySqlCode(btn) {
            const codeText = btn.previousElementSibling.innerText;
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            btn.innerText = "تم النسخ!";
            setTimeout(() => btn.innerText = "نسخ الكود", 2000);
        }

        function startTest(e) {
            e.preventDefault();
            const name = document.getElementById('studentName').value.trim();
            const email = document.getElementById('studentEmail').value.trim();
            if (!name) return;

            currentStudent = { name, email };
            currentQuestionIndex = 0;
            userAnswers = {};
            timeLeftSeconds = 20 * 60;

            document.getElementById('welcomeView').classList.add('hidden');
            document.getElementById('examView').classList.remove('hidden');
            document.getElementById('totalQNum').innerText = questionsList.length;

            startTimer();
            renderQuestion();
        }

        function startTimer() {
            if (examTimerInterval) clearInterval(examTimerInterval);
            examTimerInterval = setInterval(() => {
                if (timeLeftSeconds <= 0) {
                    clearInterval(examTimerInterval);
                    finishExam();
                    return;
                }
                timeLeftSeconds--;
                const mins = Math.floor(timeLeftSeconds / 60);
                const secs = timeLeftSeconds % 60;
                document.getElementById('timerText').innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }, 1000);
        }

        function renderQuestion() {
            const q = questionsList[currentQuestionIndex];
            document.getElementById('currentQNum').innerText = currentQuestionIndex + 1;
            document.getElementById('categoryBadge').innerText = `${q.category} • ${q.level}`;

            // Progress bar
            const progress = ((currentQuestionIndex) / questionsList.length) * 100;
            document.getElementById('progressBar').style.width = `${progress}%`;

            // Audio prompt handling
            const audioSec = document.getElementById('audioSection');
            if (q.isAudio) {
                audioSec.classList.remove('hidden');
            } else {
                audioSec.classList.add('hidden');
            }

            // Reading text handling
            const readingSec = document.getElementById('readingSection');
            if (q.readingText) {
                readingSec.classList.remove('hidden');
                readingSec.innerText = q.readingText;
            } else {
                readingSec.classList.add('hidden');
            }

            document.getElementById('questionText').innerText = q.question;

            // Options
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const isSelected = userAnswers[currentQuestionIndex] === idx;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `w-full text-right px-5 py-3.5 rounded-2xl border transition text-sm flex items-center justify-between ${
                    isSelected 
                        ? 'border-indigo-600 bg-indigo-50/70 dark:bg-indigo-950/50 text-indigo-900 dark:text-indigo-200 font-bold shadow-sm' 
                        : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-700/40 text-slate-800 dark:text-slate-200 hover:border-indigo-300'
                }`;
                btn.innerHTML = `<span>${opt}</span><span class="w-5 h-5 rounded-full border flex items-center justify-center text-xs ${isSelected ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300 dark:border-slate-500'}">${isSelected ? '<i class="fa-solid fa-check text-[10px]"></i>' : ''}</span>`;
                btn.onclick = () => selectOption(idx);
                container.appendChild(btn);
            });

            // Prev / Next button state
            document.getElementById('prevBtn').disabled = currentQuestionIndex === 0;
            const nextBtn = document.getElementById('nextBtn');
            if (currentQuestionIndex === questionsList.length - 1) {
                nextBtn.innerText = "إنهاء وتسليم الاختبار";
                nextBtn.className = "px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm transition shadow-md shadow-emerald-500/20";
            } else {
                nextBtn.innerText = "التالي";
                nextBtn.className = "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm transition shadow-md shadow-indigo-500/20";
            }
        }

        function selectOption(optionIndex) {
            userAnswers[currentQuestionIndex] = optionIndex;
            renderQuestion();
        }

        function prevQuestion() {
            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                renderQuestion();
            }
        }

        function nextQuestion() {
            if (currentQuestionIndex < questionsList.length - 1) {
                currentQuestionIndex++;
                renderQuestion();
            } else {
                finishExam();
            }
        }

        function playAudioPrompt() {
            const q = questionsList[currentQuestionIndex];
            if ('speechSynthesis' in window && q.audioTextToSpeech) {
                const utterance = new SpeechSynthesisUtterance(q.audioTextToSpeech);
                utterance.lang = 'en-US';
                window.speechSynthesis.speak(utterance);
                const btnText = document.getElementById('audioBtnText');
                btnText.innerText = "جاري التشغيل...";
                utterance.onend = () => { btnText.innerText = "تشغيل الصوت مرة أخرى"; };
            }
        }

        async function finishExam() {
            if (examTimerInterval) clearInterval(examTimerInterval);

            // Calculate score
            let score = 0;
            let skillsStats = { Grammar: { correct: 0, total: 0 }, Vocabulary: { correct: 0, total: 0 }, Reading: { correct: 0, total: 0 }, Listening: { correct: 0, total: 0 } };

            questionsList.forEach((q, idx) => {
                const cat = q.category;
                if (!skillsStats[cat]) skillsStats[cat] = { correct: 0, total: 0 };
                skillsStats[cat].total++;

                if (userAnswers[idx] === q.correct) {
                    score++;
                    skillsStats[cat].correct++;
                }
            });

            const maxScore = questionsList.length;
            const percentage = Math.round((score / maxScore) * 100);

            // Determine CEFR level
            let cefrLevel = "A1";
            let cefrDesc = "مستوى مبتدئ: تستطيع فهم واستخدام التعبيرات المألوفة اليومية والجمل البسيطة.";
            let recommendation = "يُنصح بالتركيز على قواعد تكوين الجمل الأساسية والمفردات اليومية الشائعة.";

            if (percentage >= 88) {
                cefrLevel = "C1 - Advanced";
                cefrDesc = "مستوى متقدم: تفهم مجموعة واسعة من النصوص الطويلة والصعبة وتعبر بطلاقة وعفوية.";
                recommendation = "أداؤك ممتاز جداً! يمكنك ممارسة المصطلحات الأكاديمية والمهنية الدقيقة.";
            } else if (percentage >= 72) {
                cefrLevel = "B2 - Upper Intermediate";
                cefrDesc = "مستوى متوسط متقدم: تفهم الأفكار الرئيسية للنصوص المعقدة وتتفاعل بعفوية مع المتحدثين الأصليين.";
                recommendation = "ننصحك بممارسة الاستماع للمقالات الصوتية المتقدمة وقراءة الأدبيات المتخصصة.";
            } else if (percentage >= 52) {
                cefrLevel = "B1 - Intermediate";
                cefrDesc = "مستوى متوسط: تتعامل مع معظم المواقف المحتملة أثناء السفر وتستطيع وصف الخبرات والأحداث.";
                recommendation = "ركز على تعزيز الأزمنة المركبة (مثل الماضى التام والمبني للمجهول) وتوسيع الحصيلة اللفظية.";
            } else if (percentage >= 32) {
                cefrLevel = "A2 - Elementary";
                cefrDesc = "مستوى دون المتوسط: تفهم الجمل والتعبيرات المرتبطة بالمجالات القريبة جداً (المعلومات الشخصية والعائلية).";
                recommendation = "عليك بتقوية بناء الجمل والمفردات الأساسية الخاصة بالحياة اليومية والعمل.";
            }

            // Update UI
            document.getElementById('examView').classList.add('hidden');
            document.getElementById('resultsView').classList.remove('hidden');

            document.getElementById('resultCefrBadge').innerText = cefrLevel;
            document.getElementById('resultCefrDesc').innerText = cefrDesc;
            document.getElementById('resultScoreText').innerText = `${score}/${maxScore}`;
            document.getElementById('resultPercentText').innerText = `${percentage}%`;
            document.getElementById('recommendationText').innerText = recommendation;

            // Render Skills Chart
            renderSkillsChart(skillsStats);

            // Save result to Supabase or LocalStorage
            const submissionData = {
                student_name: currentStudent.name,
                student_email: currentStudent.email || 'غير متوفر',
                total_score: score,
                max_score: maxScore,
                percentage: percentage,
                cefr_level: cefrLevel,
                skills_breakdown: skillsStats,
                created_at: new Date().toISOString()
            };

            await saveSubmissionToDatabase(submissionData);
        }

        let skillsChartInstance = null;
        function renderSkillsChart(stats) {
            const ctx = document.getElementById('skillsChart').getContext('2d');
            if (skillsChartInstance) skillsChartInstance.destroy();

            const labels = Object.keys(stats);
            const data = labels.map(l => stats[l].total > 0 ? Math.round((stats[l].correct / stats[l].total) * 100) : 0);

            skillsChartInstance = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'نسبة الإتقان للمهارة %',
                        data: data,
                        backgroundColor: 'rgba(99, 102, 241, 0.2)',
                        borderColor: '#6366f1',
                        borderWidth: 2,
                        pointBackgroundColor: '#4f46e5'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { stepSize: 25 }
                        }
                    }
                }
            });
        }

        async function saveSubmissionToDatabase(data) {
            const noteEl = document.getElementById('saveStatusNote');
            if (isSupabaseConfigured && supabaseClient) {
                try {
                    const { error } = await supabaseClient.from('exam_results').insert([data]);
                    if (error) throw error;
                    noteEl.innerHTML = `<i class="fa-solid fa-cloud-check text-emerald-500"></i><span>تم حفظ نتيجتك بنجاح في جدول Supabase.</span>`;
                } catch (err) {
                    console.error("Supabase insert error:", err);
                    saveToLocalStorageOnly(data);
                    noteEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-500"></i><span>تعذر الحفظ بـ Supabase، تم الحفظ محلياً (Local Storage).</span>`;
                }
            } else {
                saveToLocalStorageOnly(data);
                noteEl.innerHTML = `<i class="fa-solid fa-database text-indigo-500"></i><span>تم الحفظ في التخزين المحلي بنجاح (Local Mode).</span>`;
            }
        }

        function saveToLocalStorageOnly(data) {
            let localList = JSON.parse(localStorage.getItem('local_exam_submissions') || '[]');
            localList.unshift(data);
            localStorage.setItem('local_exam_submissions', JSON.stringify(localList));
        }

        function resetToHome() {
            if (examTimerInterval) clearInterval(examTimerInterval);
            document.getElementById('examView').classList.add('hidden');
            document.getElementById('resultsView').classList.add('hidden');
            document.getElementById('adminView').classList.add('hidden');
            document.getElementById('welcomeView').classList.remove('hidden');
            document.getElementById('studentName').value = '';
            document.getElementById('studentEmail').value = '';
        }

        function openAdminModal() {
            document.getElementById('adminUser').value = '';
            document.getElementById('adminPass').value = '';
            document.getElementById('loginErrorMsg').classList.add('hidden');
            document.getElementById('adminLoginModal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('adminLoginModal').classList.add('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const u = document.getElementById('adminUser').value.trim();
            const p = document.getElementById('adminPass').value.trim();

            // Check against default credentials and the newly requested credentials
            if ((u === 'admintest' && p === '123456789') || (u === 'test 6565' && p === '123456')) {
                closeAdminModal();
                openAdminDashboard();
            } else {
                document.getElementById('loginErrorMsg').classList.remove('hidden');
            }
        }

        async function openAdminDashboard() {
            document.getElementById('welcomeView').classList.add('hidden');
            document.getElementById('examView').classList.add('hidden');
            document.getElementById('resultsView').classList.add('hidden');
            document.getElementById('adminView').classList.remove('hidden');
            await fetchAdminData();
        }

        function closeAdminDashboard() {
            document.getElementById('adminView').classList.add('hidden');
            document.getElementById('welcomeView').classList.remove('hidden');
        }

        async function fetchAdminData() {
            adminSubmissions = [];
            const sourceEl = document.getElementById('adminStatSource');

            if (isSupabaseConfigured && supabaseClient) {
                try {
                    const { data, error } = await supabaseClient
                        .from('exam_results')
                        .select('*')
                        .order('created_at', { ascending: false });
                    if (error) throw error;
                    adminSubmissions = data || [];
                    sourceEl.innerText = "Supabase DB";
                } catch (err) {
                    console.error("Fetch Supabase error:", err);
                    adminSubmissions = JSON.parse(localStorage.getItem('local_exam_submissions') || '[]');
                    sourceEl.innerText = "Local Storage (Fallback)";
                }
            } else {
                adminSubmissions = JSON.parse(localStorage.getItem('local_exam_submissions') || '[]');
                sourceEl.innerText = "Local Storage Mode";
            }

            renderAdminTable(adminSubmissions);
            updateAdminStats(adminSubmissions);
        }

        function updateAdminStats(list) {
            const total = list.length;
            document.getElementById('adminStatTotal').innerText = total;

            if (total === 0) {
                document.getElementById('adminStatAvg').innerText = "0%";
                document.getElementById('adminStatTopLevel').innerText = "-";
                return;
            }

            const avgPct = Math.round(list.reduce((acc, curr) => acc + curr.percentage, 0) / total);
            document.getElementById('adminStatAvg').innerText = `${avgPct}%`;

            // Find top level count
            const counts = {};
            list.forEach(item => {
                const lvl = item.cefr_level ? item.cefr_level.split(' ')[0] : 'A1';
                counts[lvl] = (counts[lvl] || 0) + 1;
            });
            let topLvl = '-';
            let maxC = -1;
            for (let lvl in counts) {
                if (counts[lvl] > maxC) {
                    maxC = counts[lvl];
                    topLvl = lvl;
                }
            }
            document.getElementById('adminStatTopLevel').innerText = topLvl;
        }

        function renderAdminTable(list) {
            const tbody = document.getElementById('adminTableBody');
            tbody.innerHTML = '';

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400">لا توجد سجلات لطلاب متقدمين حتى الآن.</td></tr>`;
                return;
            }

            list.forEach((item, index) => {
                const dateStr = item.created_at ? new Date(item.created_at).toLocaleString('ar-SA') : 'حديث';
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 dark:hover:bg-slate-700/30 transition";
                
                tr.innerHTML = `
                    <td class="p-3.5 font-bold text-slate-900 dark:text-white">
                        <div>${item.student_name}</div>
                        <div class="text-[10px] text-slate-400 font-normal">${item.student_email || ''}</div>
                    </td>
                    <td class="p-3.5"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-300">${item.cefr_level}</span></td>
                    <td class="p-3.5 font-mono font-bold">${item.total_score} / ${item.max_score}</td>
                    <td class="p-3.5 font-bold text-emerald-600 dark:text-emerald-400">${item.percentage}%</td>
                    <td class="p-3.5 text-[11px] text-slate-500">
                        ${item.skills_breakdown ? Object.keys(item.skills_breakdown).map(k => `${k}: ${item.skills_breakdown[k].correct}/${item.skills_breakdown[k].total}`).join(' | ') : 'غير متوفر'}
                    </td>
                    <td class="p-3.5 text-slate-400 text-[11px]">${dateStr}</td>
                    <td class="p-3.5 text-center">
                        <button onclick="deleteSubmission(${index})" class="p-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 dark:bg-rose-950/40 dark:text-rose-400 transition" title="حذف النتيجة">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterAdminResults() {
            const query = document.getElementById('adminSearchInput').value.toLowerCase();
            const levelFilter = document.getElementById('adminLevelFilter').value;

            const filtered = adminSubmissions.filter(item => {
                const matchName = item.student_name.toLowerCase().includes(query) || (item.student_email && item.student_email.toLowerCase().includes(query));
                const matchLevel = levelFilter === 'ALL' || (item.cefr_level && item.cefr_level.includes(levelFilter));
                return matchName && matchLevel;
            });

            renderAdminTable(filtered);
        }

        async function deleteSubmission(index) {
            const item = adminSubmissions[index];
            if (isSupabaseConfigured && supabaseClient && item.id) {
                try {
                    await supabaseClient.from('exam_results').delete().eq('id', item.id);
                } catch (err) {
                    console.error("Delete error Supabase:", err);
                }
            }
            
            // Also remove from local fallback list
            let localList = JSON.parse(localStorage.getItem('local_exam_submissions') || '[]');
            localList.splice(index, 1);
            localStorage.setItem('local_exam_submissions', JSON.stringify(localList));

            fetchAdminData();
        }

        function exportToCSV() {
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF" + "اسم الطالب,البريد الإلكتروني,المستوى,الدرجة الكلية,النسبة المئوية,التاريخ\n";
            adminSubmissions.forEach(item => {
                csvContent += `"${item.student_name}","${item.student_email || ''}","${item.cefr_level}",${item.total_score}/${item.max_score},${item.percentage}%,${item.created_at || ''}\n`;
            });
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "english_exam_results.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</HTML>

