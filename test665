                renderQuestion();
            } else {
                finishTest();
            }
        }

        // Speech Synthesis for Listening Questions
        function playAudioPrompt() {
            const q = questionsData[currentQuestionIndex];
            if (!q.audioText) return;

            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(q.audioText);
            utterance.lang = 'en-US';
            utterance.rate = 0.9;

            const btnText = document.getElementById('audioBtnText');
            btnText.textContent = "جاري التشغيل...";

            utterance.onend = () => { btnText.textContent = "إعادة التشغيل"; };
            utterance.onerror = () => { btnText.textContent = "إعادة التشغيل"; };

            window.speechSynthesis.speak(utterance);
        }

        // Finish & Calculate Results
        async function finishTest() {
            clearInterval(timerInterval);

            let score = 0;
            let breakdown = { Grammar: { correct: 0, total: 0 }, Vocabulary: { correct: 0, total: 0 }, Reading: { correct: 0, total: 0 }, Listening: { correct: 0, total: 0 } };

            questionsData.forEach((q, idx) => {
                if (!breakdown[q.category]) breakdown[q.category] = { correct: 0, total: 0 };
                breakdown[q.category].total++;

                if (userAnswers[idx] === q.answer) {
                    score++;
                    breakdown[q.category].correct++;
                }
            });

            const percentage = Math.round((score / questionsData.length) * 100);
            const cefr = calculateCEFRLevel(score, percentage);

            // Render Results Screen
            document.getElementById('resultCefrBadge').textContent = `${cefr.level} - ${cefr.title}`;
            document.getElementById('resultCefrDesc').textContent = cefr.description;
            document.getElementById('resultScoreText').textContent = `${score}/${questionsData.length}`;
            document.getElementById('resultPercentText').textContent = `${percentage}%`;
            document.getElementById('recommendationText').textContent = cefr.recommendation;

            renderSkillsChart(breakdown);
            switchView('resultsView');

            // Save Result to Supabase or Local Storage
            const record = {
                student_name: studentData.name,
                student_email: studentData.email || null,
                cefr_level: `${cefr.level} - ${cefr.title}`,
                score: score,
                total_questions: questionsData.length,
                percentage: percentage,
                grammar_score: breakdown.Grammar?.correct || 0,
                vocab_score: breakdown.Vocabulary?.correct || 0,
                reading_score: breakdown.Reading?.correct || 0,
                listening_score: breakdown.Listening?.correct || 0,
                time_spent_seconds: timeSpentSeconds,
                category_breakdown: breakdown,
                created_at: new Date().toISOString()
            };

            await saveTestResult(record);
        }

        function calculateCEFRLevel(score, percentage) {
            if (percentage >= 88) {
                return {
                    level: "C1",
                    title: "Advanced",
                    description: "تستطيع فهم طيف واسع من النصوص الطويلة والمعقدة، والتعبير بعفوية وطلاقة دون الحاجة للبحث عن الكلمات.",
                    recommendation: "تركز توصياتك على القراءة في المجلات الأكاديمية وصياغة مقالات متقدمة وتطوير الدقة اللغوية بالمحادثات الاحترافية."
                };
            } else if (percentage >= 72) {
                return {
                    level: "B2",
                    title: "Upper Intermediate",
                    description: "تستطيع فهم الأفكار الرئيسية للنصوص المعقدة والتفاعل بعفوية سلسة مع الناطقين بها.",
                    recommendation: "يُنصح بزيادة حصيلتك من المصطلحات التخصصية والأفعال المركبة (Phrasal Verbs) وممارسة كتابة التقارير الرسمية."
                };
            } else if (percentage >= 52) {
                return {
                    level: "B1",
                    title: "Intermediate",
                    description: "تستطيع التعامل مع معظم المواقف اليومية واستيعاب النقاط الرئيسية في المواضيع الفكرية والعملية.",
                    recommendation: "استمر في مشاهدة البرامج بدون ترجمة وتدرب على الأفكار المركبة وقواعد الأزمنة التامة."
                };
            } else if (percentage >= 32) {
                return {
                    level: "A2",
                    title: "Elementary",
                    description: "تستطيع فهم الجمل والتعابير المباشرة المتعلقة بالمجالات ذات الأهمية المباشرة (العائلة، التسوق، العمل).",
                    recommendation: "قم بزيادة حصيلة المفردات اليومية ومراجعة قواعد الماضي البسيط والمستقبل."
                };
            } else {
                return {
                    level: "A1",
                    title: "Beginner",
                    description: "تستطيع فهم واستخدام التعابير اليومية البسيطة والعبارات الأساسية للغاية لتلبية الاحتياجات الأولية.",
                    recommendation: "ابدأ بدراسة الأساسيات وقواعد الحاضر البسيط والمفردات التعريفية الأساسية."
                };
            }
        }

        // Render Skills Chart
        function renderSkillsChart(breakdown) {
            const ctx = document.getElementById('skillsChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();

            const categories = Object.keys(breakdown);
            const percentages = categories.map(cat => {
                const b = breakdown[cat];
                return b.total > 0 ? Math.round((b.correct / b.total) * 100) : 0;
            });

            chartInstance = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['القواعد', 'المفردات', 'القراءة', 'الاستماع'],
                    datasets: [{
                        label: 'نسبة الإتقان %',
                        data: percentages,
                        backgroundColor: 'rgba(99, 102, 241, 0.2)',
                        borderColor: 'rgba(99, 102, 241, 1)',
                        pointBackgroundColor: 'rgba(99, 102, 241, 1)',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            min: 0,
                            max: 100,
                            ticks: { display: false }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // Save Result to Supabase or LocalStorage
        async function saveTestResult(record) {
            const saveNote = document.getElementById('saveStatusNote');

            if (supabaseClient) {
                try {
                    const { data, error } = await supabaseClient
                        .from('test_results')
                        .insert([record]);

                    if (error) throw error;

                    saveNote.innerHTML = '<i class="fa-solid fa-cloud-check text-emerald-500"></i><span>تم حفظ نتيجتك بنجاح في قاعدة بيانات Supabase.</span>';
                    saveNote.className = "text-xs p-3 rounded-xl bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 flex items-center gap-2 border border-emerald-200 dark:border-emerald-800";
                } catch (err) {
                    console.warn("Supabase Save Error, falling back to LocalStorage:", err);
                    saveToLocalStorage(record);
                    saveNote.innerHTML = '<i class="fa-solid fa-circle-info text-amber-500"></i><span>تم حفظ النتيجة محلياً (تعذر الاتصال بـ Supabase).</span>';
                }
            } else {
                saveToLocalStorage(record);
                saveNote.innerHTML = '<i class="fa-solid fa-hard-drive text-slate-500"></i><span>تم حفظ نتيجتك في التخزين المحلي للجهاز.</span>';
            }
        }

        function saveToLocalStorage(record) {
            let existing = JSON.parse(localStorage.getItem('placement_test_results') || '[]');
            existing.unshift({ ...record, id: crypto.randomUUID() });
            localStorage.setItem('placement_test_results', JSON.stringify(existing));
        }

        // ==========================================
        // Admin Dashboard Logic
        // ==========================================
        function openAdminModal() {
            document.getElementById('adminLoginModal').classList.remove('hidden');
            document.getElementById('loginErrorMsg').classList.add('hidden');
        }

        function closeAdminModal() {
            document.getElementById('adminLoginModal').classList.add('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const u = document.getElementById('adminUser').value.trim();
            const p = document.getElementById('adminPass').value.trim();

            if (u === ADMIN_USER && p === ADMIN_PASS) {
                closeAdminModal();
                switchView('adminView');
                fetchAdminData();
            } else {
                document.getElementById('loginErrorMsg').classList.remove('hidden');
            }
        }

        function closeAdminDashboard() {
            resetToHome();
        }

        async function fetchAdminData() {
            const tableBody = document.getElementById('adminTableBody');
            tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-slate-400">جاري تحميل البيانات...</td></tr>';

            let records = [];
            let isSupabase = false;

            if (supabaseClient) {
                try {
                    const { data, error } = await supabaseClient
                        .from('test_results')
                        .select('*')
                        .order('created_at', { ascending: false });

                    if (error) throw error;
                    records = data || [];
                    isSupabase = true;
                } catch (e) {
                    console.warn("Could not load from Supabase, loading local storage:", e);
                    records = JSON.parse(localStorage.getItem('placement_test_results') || '[]');
                }
            } else {
                records = JSON.parse(localStorage.getItem('placement_test_results') || '[]');
            }

            adminResultsCache = records;
            document.getElementById('adminStatSource').textContent = isSupabase ? "Supabase DB" : "التخزين المحلي";
            renderAdminTable(records);
            updateAdminStats(records);
        }

        function updateAdminStats(records) {
            document.getElementById('adminStatTotal').textContent = records.length;

            if (records.length === 0) {
                document.getElementById('adminStatAvg').textContent = '0%';
                document.getElementById('adminStatTopLevel').textContent = '-';
                return;
            }

            const avg = Math.round(records.reduce((acc, r) => acc + (r.percentage || 0), 0) / records.length);
            document.getElementById('adminStatAvg').textContent = `${avg}%`;

            // Most frequent level
            const levelCounts = {};
            records.forEach(r => {
                const code = (r.cefr_level || 'A1').substring(0, 2);
                levelCounts[code] = (levelCounts[code] || 0) + 1;
            });
            let topLvl = Object.keys(levelCounts).reduce((a, b) => levelCounts[a] > levelCounts[b] ? a : b, '-');
            document.getElementById('adminStatTopLevel').textContent = topLvl;
        }

        function renderAdminTable(records) {
            const tableBody = document.getElementById('adminTableBody');
            tableBody.innerHTML = '';

            if (records.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-slate-400">لا توجد نتائج مسجلة حتى الآن</td></tr>';
                return;
            }

            records.forEach(r => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 dark:hover:bg-slate-700/30 transition";

                const dateStr = new Date(r.created_at).toLocaleDateString('ar-EG', {
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
                });

                const cefrCode = (r.cefr_level || '').substring(0, 2);
                let badgeColor = "bg-slate-100 text-slate-700";
                if (cefrCode === 'C1') badgeColor = "bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300";
                if (cefrCode === 'B2') badgeColor = "bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300";
                if (cefrCode === 'B1') badgeColor = "bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300";
                if (cefrCode === 'A2') badgeColor = "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300";

                tr.innerHTML = `
                    <td class="p-3.5 font-bold">
                        <div>${escapeHtml(r.student_name)}</div>
                        <div class="text-[10px] font-normal text-slate-400" dir="ltr">${escapeHtml(r.student_email || 'بدون بريد')}</div>
                    </td>
                    <td class="p-3.5">
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold ${badgeColor}">
                            ${escapeHtml(r.cefr_level || 'A1')}
                        </span>
                    </td>
                    <td class="p-3.5 font-bold text-indigo-600 dark:text-indigo-400">${r.score}/25</td>
                    <td class="p-3.5 font-bold">${r.percentage}%</td>
                    <td class="p-3.5 text-[11px] text-slate-500 dark:text-slate-400">
                        قواعد: ${r.grammar_score || 0} | مفردات: ${r.vocab_score || 0} | قراءة: ${r.reading_score || 0} | استماع: ${r.listening_score || 0}
                    </td>
                    <td class="p-3.5 text-[11px] text-slate-400">${dateStr}</td>
                    <td class="p-3.5 text-center">
                        <button onclick="deleteRecord('${r.id}')" class="text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 transition">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tableBody.appendChild(tr);
            });
        }

        function filterAdminResults() {
            const query = document.getElementById('adminSearchInput').value.toLowerCase();
            const level = document.getElementById('adminLevelFilter').value;

            const filtered = adminResultsCache.filter(r => {
                const matchesQuery = (r.student_name || '').toLowerCase().includes(query) || (r.student_email || '').toLowerCase().includes(query);
                const matchesLevel = level === 'ALL' || (r.cefr_level || '').startsWith(level);
                return matchesQuery && matchesLevel;
            });

            renderAdminTable(filtered);
        }

        async function deleteRecord(id) {
            if (!id) return;

            if (supabaseClient) {
                try {
                    await supabaseClient.from('test_results').delete().eq('id', id);
                } catch (e) {
                    console.error("Supabase Delete Error:", e);
                }
            }

            // Delete from local cache
            let local = JSON.parse(localStorage.getItem('placement_test_results') || '[]');
            local = local.filter(x => x.id !== id);
            localStorage.setItem('placement_test_results', JSON.stringify(local));

            fetchAdminData();
        }

        function exportToCSV() {
            if (adminResultsCache.length === 0) return;

            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            csvContent += "الاسم,البريد,المستوى,الدرجة,النسبة,القواعد,المفردات,القراءة,الاستماع,التاريخ\n";

            adminResultsCache.forEach(r => {
                csvContent += `"${r.student_name}","${r.student_email || ''}","${r.cefr_level}",${r.score},${r.percentage}%,${r.grammar_score},${r.vocab_score},${r.reading_score},${r.listening_score},"${r.created_at}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `English_Placement_Test_Results_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Modal triggers
        function openSupabaseConfigModal() {
            document.getElementById('cfgSupaUrl').value = localStorage.getItem('supabase_url') || '';
            document.getElementById('cfgSupaKey').value = localStorage.getItem('supabase_key') || '';
            document.getElementById('supabaseConfigModal').classList.remove('hidden');
        }

        function closeSupabaseConfigModal() {
            document.getElementById('supabaseConfigModal').classList.add('hidden');
        }

        function saveSupabaseConfig(e) {
            e.preventDefault();
            const url = document.getElementById('cfgSupaUrl').value.trim();
            const key = document.getElementById('cfgSupaKey').value.trim();

            if (url && key) {
                localStorage.setItem('supabase_url', url);
                localStorage.setItem('supabase_key', key);
            }
            closeSupabaseConfigModal();
            initSupabaseFromStorage();
        }

        function useLocalStorageOnly() {
            localStorage.removeItem('supabase_url');
            localStorage.removeItem('supabase_key');
            closeSupabaseConfigModal();
            setLocalStorageStatus();
        }

        function openSqlModal() {
            document.getElementById('sqlModal').classList.remove('hidden');
        }

        function closeSqlModal() {
            document.getElementById('sqlModal').classList.add('hidden');
        }

        function copySqlScript() {
            const text = document.getElementById('sqlCodeBlock').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.innerHTML = '<i class="fa-solid fa-check"></i><span>تم النسخ!</span>';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fa-regular fa-copy"></i><span>نسخ الكود</span>';
                }, 2000);
            });
        }

        // View Router Helper
        function switchView(viewId) {
            ['welcomeView', 'examView', 'resultsView', 'adminView'].forEach(id => {
                const el = document.getElementById(id);
                if (id === viewId) {
                    el.classList.remove('hidden');
                    el.classList.add('block');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('block');
                }
            });
        }

        function resetToHome() {
            clearInterval(timerInterval);
            switchView('welcomeView');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
</body>
